+    t0 = time.monotonic()
+    claim = bc.acquire(cluster, "pool-a")
+    claimed_ttl = claim.expires_at - t0
+
+    assert actual_k8s_ttl_s < 100.0
+    assert claimed_ttl <= 639.05, (
+        f"F-19 violated: BatchClaim.expires_at assumed full {claimed_ttl:.2f}s TTL without "
