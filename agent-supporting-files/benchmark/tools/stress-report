# stress-report renders the static HTML bottleneck report from a
# test/stress run's output directory (see dev/tools/stress-test-kind),
# using the same generator CI uses: test/stress/generate-report/generate_report.py.
#
# duckdb/jinja2 are installed into a dedicated venv under
# bin/stress-report-venv (mirrors the "report-venv" step in
# test/benchmarks/scenarios/benchmarks-kops-gcp/run) rather than the shared
# bin/dev-tools-venv, since those two packages are only needed here. The
# venv is reused across runs; delete bin/stress-report-venv to force a
# clean reinstall.
#
# Usage:
#   dev/tools/stress-report [--venv-only] [--input-dir DIR] [--output-dir DIR]

set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

VENV_DIR="${REPO_ROOT}/bin/stress-report-venv"
INPUT_DIR="${STRESS_OUTPUT_DIR:-${REPO_ROOT}/bin/stress-test}"
OUTPUT_DIR="${STRESS_REPORT_DIR:-${INPUT_DIR}/report}"
VENV_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --venv-only) VENV_ONLY=true; shift ;;
    --input-dir) INPUT_DIR="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

if [[ ! -x "${VENV_DIR}/bin/python3" ]]; then
  echo "Setting up report venv at ${VENV_DIR}..."
  python3 -m venv "${VENV_DIR}"
  "${VENV_DIR}/bin/pip" install --quiet --upgrade pip
  "${VENV_DIR}/bin/pip" install --quiet 'duckdb>=1,<2' 'jinja2>=3,<4'
else
  echo "Reusing existing report venv at ${VENV_DIR}."
fi

if [[ "${VENV_ONLY}" == "true" ]]; then
  exit 0
fi

echo "Generating stress test report from ${INPUT_DIR} to ${OUTPUT_DIR}..."
"${VENV_DIR}/bin/python3" test/stress/generate-report/generate_report.py \
  --input-dir "${INPUT_DIR}" \
  --output-dir "${OUTPUT_DIR}"

echo "Report generated at ${OUTPUT_DIR}/index.html"
